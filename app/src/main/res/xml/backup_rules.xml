<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. A user's study progress (Room database, DataStore settings and streak,
     the "who I'm doing this for" photo) is backed up and restored on a new phone, so a paying user
     never starts over. Rendered share cards in cache/ are never backed up. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
